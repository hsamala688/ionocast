# TEC map data source override. Optional.
#
# In production the app fetches from the SAME-ORIGIN "/tec" path (served by the
# Cloudflare Worker in worker/index.ts), so you normally set nothing here.
#
# Local development:
#   - `vite` dev server (npm run dev) has no "/tec" handler, so point it at a
#     live origin that does:
#       VITE_TEC_BASE_URL=https://www.ionocast.com
#   - OR run `wrangler dev` instead of `vite`, which serves "/tec" locally via
#     the Worker (use `wrangler dev --remote` to hit the real R2 bucket).
